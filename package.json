{
  "name": "chartshelf",
  "version": "0.1.0",
  "description": "MIT-licensed, dependency-free charts for the web.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://peternickol.github.io/chartshelf/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peternickol/chartshelf.git"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./chartshelf.d.ts",
  "exports": {
    ".": {
      "types": "./chartshelf.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "chartshelf.d.ts",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "demo": "python3 -m http.server 4173"
  },
  "keywords": [
    "chart",
    "charts",
    "svg",
    "visualization"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
